{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/gitleaks-setup.sh", "--session"],
            "statusMessage": "Checking for gitleaks..."
          }
        ]
      }
    ]
  }
}
