#!/usr/bin/env bash
# Create and inspect sp slice worktrees.
#
# Usage: sp-worktree create <slug> <feat|fix>
#        sp-worktree branch-for <dir>
#
# create      makes .claude/worktrees/<slug> on branch <prefix>/<slug>, runs the
#             configured sync command inside it, symlinks .env if the main
#             checkout has one, and creates the slice's .claude/sp/ scratch dir.
# branch-for  prints the branch a worktree directory is checked out on. Host
#             repos contain worktrees whose directory name does not match their
#             branch, so this reads git rather than reconstructing the name.
#
# Governs new worktrees only; it never renames or migrates existing ones.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
die() { printf 'sp-worktree: %s\n' "$1" >&2; exit 1; }

# Print the header comment, stopping at the first non-comment line, so the help
# text cannot drift out of sync with the file's line numbering.
usage() { awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"; }

# The main checkout, even when invoked from inside another worktree. Resolved by
# the subcommands that need it, so --help works outside a repository.
main_root=""
resolve_main_root() {
  git rev-parse --git-common-dir >/dev/null 2>&1 || die "not inside a git repository"
  main_root=$(dirname "$(cd "$(git rev-parse --git-common-dir)" && pwd -P)")
}

cmd="${1:-}"
[ -n "$cmd" ] || { usage; exit 1; }
shift || true

case "$cmd" in
  create)
    slug="${1:-}"; prefix="${2:-}"
    [ -n "$slug" ] && [ -n "$prefix" ] || die "usage: sp-worktree create <slug> <feat|fix>"
    resolve_main_root
    case "$prefix" in
      feat|fix) ;;
      *) die "unknown prefix '$prefix' — expected feat or fix" ;;
    esac

    config=$(cd "$main_root" && "$HERE/sp-preflight") || exit 1
    sync_cmd=$(sed -n 's/^sync=//p' <<<"$config" | head -1)

    dir="$main_root/.claude/worktrees/$slug"
    [ -e "$dir" ] && die "worktree directory already exists: .claude/worktrees/$slug"

    # Reuse an existing branch rather than failing on it, as /sp:start did before
    # these scripts existed. Only a branch we created is rolled back below.
    branch_created=0
    if git -C "$main_root" show-ref --verify --quiet "refs/heads/$prefix/$slug"; then
      git -C "$main_root" worktree add "$dir" "$prefix/$slug" \
        || die "git worktree add failed for existing branch $prefix/$slug"
    else
      git -C "$main_root" worktree add "$dir" -b "$prefix/$slug" \
        || die "git worktree add failed for $prefix/$slug"
      branch_created=1
    fi

    # Anything below can fail; leaving a half-built worktree behind would make a
    # retry hit "already exists" instead of re-running the step that failed.
    rollback() {
      git -C "$main_root" worktree remove --force "$dir" >/dev/null 2>&1 || true
      [ "$branch_created" -eq 1 ] \
        && git -C "$main_root" branch -D "$prefix/$slug" >/dev/null 2>&1 || true
    }

    # The scratch directory ignores itself, so a host repo needs no .gitignore entry
    # of its own — otherwise slice state would show up in git status and could be
    # staged into the slice's own PR.
    mkdir -p "$dir/.claude/sp" || { rollback; die "failed to create the scratch directory"; }
    printf '*\n' >"$dir/.claude/sp/.gitignore" \
      || { rollback; die "failed to write the scratch .gitignore"; }

    if [ -f "$main_root/.env" ]; then
      ln -sf "$main_root/.env" "$dir/.env" \
        || { rollback; die "failed to symlink .env into the worktree"; }
    fi

    if [ -n "$sync_cmd" ]; then
      ( cd "$dir" && eval "$sync_cmd" ) \
        || { rollback; die "sync command failed inside the worktree: $sync_cmd — worktree and branch rolled back"; }
    fi

    printf 'worktree=%s\n' ".claude/worktrees/$slug"
    printf 'branch=%s\n'   "$prefix/$slug"
    printf 'scratch=%s\n'  ".claude/worktrees/$slug/.claude/sp"
    ;;

  branch-for)
    resolve_main_root
    target="${1:-}"
    [ -n "$target" ] || die "usage: sp-worktree branch-for <dir>"
    abs=$(cd "$target" 2>/dev/null && pwd -P) \
      || die "not a directory: $target"

    wt=""; found=""
    while IFS= read -r line; do
      case "$line" in
        "worktree "*)
          wt=${line#worktree }
          wt=$(cd "$wt" 2>/dev/null && pwd -P) || wt=""
          ;;
        "branch "*)
          [ "$wt" = "$abs" ] && found=${line#branch }
          ;;
        "detached")
          [ "$wt" = "$abs" ] && found="__detached__"
          ;;
      esac
    done < <(git -C "$main_root" worktree list --porcelain)

    [ -n "$found" ] || die "no worktree registered at $target"
    [ "$found" = "__detached__" ] \
      && die "worktree at $target is in detached HEAD state, not on a branch"
    printf '%s\n' "${found#refs/heads/}"
    ;;

  -h|--help|help) usage ;;
  *) die "unknown subcommand '$cmd' — expected create or branch-for" ;;
esac
