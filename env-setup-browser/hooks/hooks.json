{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/playwright-chromium-setup.sh"],
            "statusMessage": "Ensuring Playwright Chromium is installed..."
          }
        ]
      }
    ]
  }
}
